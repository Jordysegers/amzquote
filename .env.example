# Deze waarden vul je in bij Vercel > Project > Settings > Environment Variables (NIET in GitHub zetten).

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud: API-sleutel met "Places API (New)" en "Routes API" aan
GOOGLE_MAPS_API_KEY=

# api-postcode.nl
POSTCODE_API_TOKEN=

# Anthropic (console.anthropic.com) voor het uitlezen van aanvragen
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Microsoft 365-mailbox (pas later, stap 6 in README)
# MS_TENANT_ID=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# MS_MAILBOX=offerte@amz.nl
# MS_MAP=inbox
# CRON_SECRET=een-lange-willekeurige-tekst
